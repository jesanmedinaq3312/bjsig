# Values are environment-specific and public in the browser bundle; never use a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Canonical HTTPS URL for this deployment, without credentials or trailing path.
VITE_PUBLIC_SITE_URL=

# Configure these as Supabase Edge Function secrets, not as VITE_* variables:
# WORKER_AUTH_REDIRECT_ORIGIN=https://example.com
# WORKER_AUTH_ALLOWED_REDIRECT_ORIGINS=https://example.com
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
